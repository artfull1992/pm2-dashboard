# GOIT Node Control — environment template.
# Copy to .env and fill in DB_PASS (chmod 600 .env). Never commit .env.
#
# On the server, .env is generated by `npm run db:setup`.
# Locally (VS Code), get the real file over SSH — see README "Робота через VS Code".
# DB_HOST=127.0.0.1 works locally through an SSH tunnel:
#   ssh -N -L 5432:127.0.0.1:5432 root@<server>

DB_NAME=node_control_db
DB_USER=node_control_user
DB_HOST=127.0.0.1
DB_PASS=
DB_PORT=5432

# --- Central API (backend/) — all optional, defaults shown. Process environment overrides .env.
# NODE_ENV: development | test | production
NODE_ENV=development
# Loopback by default; the API is meant to sit behind host Nginx, never exposed directly.
API_HOST=127.0.0.1
API_PORT=3100
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication (ADR-011). Placeholders only.
# Exact origins (comma-separated) allowed to call state-changing /api endpoints, incl. login.
# Empty = login and every state-changing request is refused (fail closed).
AUTH_ALLOWED_ORIGINS=
# true (default): __Host- Secure cookie. false only for loopback development outside production.
AUTH_COOKIE_SECURE=true
# Absolute session lifetime in minutes (15-1440).
AUTH_SESSION_TTL_MINUTES=480
