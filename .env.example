# Node Control — environment template.
# Copy to .env and fill in DB_PASS (chmod 600 .env). Never commit .env.
#
# On the server, .env is generated by `npm run db:setup`.
# Locally (VS Code), get the real file over SSH — see README "Робота через VS Code".
# DB_HOST=127.0.0.1 works locally through an SSH tunnel:
#   ssh -N -L 5432:127.0.0.1:5432 root@<server>

DB_NAME=node_control_db
DB_USER=node_control_user
DB_HOST=127.0.0.1
DB_PASS=
DB_PORT=5432

# --- Central API (backend/) — all optional, defaults shown. Process environment overrides .env.
# NODE_ENV: development | test | production
NODE_ENV=development
# Loopback by default; the API is meant to sit behind host Nginx, never exposed directly.
API_HOST=127.0.0.1
API_PORT=3100
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication (ADR-011). Placeholders only.
# Exact origins (comma-separated) allowed to call state-changing /api endpoints, incl. login.
# Empty = login and every state-changing request is refused (fail closed).
AUTH_ALLOWED_ORIGINS=
# true (default): __Host- Secure cookie. false only for loopback development outside production.
AUTH_COOKIE_SECURE=true
# Absolute session lifetime in minutes (15-1440).
AUTH_SESSION_TTL_MINUTES=480

# --- Reverse proxy (ADR-014). Empty (default) = trust no proxy; forwarded headers are ignored.
# Production behind the local Nginx: API_TRUSTED_PROXIES=127.0.0.1 (loopback IP literals only, max 4).
# Nginx must REPLACE the header: proxy_set_header X-Forwarded-For $remote_addr;
API_TRUSTED_PROXIES=

# --- PM2 process control (ADR-017). false (default) = no command can be created or dispatched.
PM2_CONTROL_ENABLED=false
# Alerts (ADR-021/022). Engine, delivery, rules and the Slack webhook are managed by an admin in the UI («Налаштування»)
# and stored in the database. Here only deployment-level values:
# ALERTS_SECRET_KEY=<base64 of 32 random bytes>   SECRET: encrypts the webhook at rest (api.env, 600). Generate with:
#   node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))" >> file-edited-by-hand (never echo into shell history)
# ALERTS_SECRET_KEY_VERSION=1
# ALERTS_PUBLIC_URL=https://nodecontrol.example        # https origin for "open in Node Control" links in messages
# One-time initial rule values (used only when the settings row does not exist yet), e.g.:
# ALERTS_CPU_OPEN_PERCENT=90  ALERTS_CPU_CLOSE_PERCENT=70  ALERTS_MEMORY_OPEN_PERCENT=90  ALERTS_MEMORY_CLOSE_PERCENT=80  ALERTS_INTERVAL_SECONDS=30
# Ignored since ADR-022 (a startup warning names them, never their values): ALERTS_ENABLED, ALERTS_DELIVERY_ENABLED, ALERTS_SLACK_WEBHOOK_URL

# --- Agent (agent/, ADR-015) — separate file on each managed node: /etc/node-control-agent/agent.env (600).
# NC_AGENT_API_URL=https://control.example.com
# NC_AGENT_TOKEN=            # issued once in the UI (Servers → server → "Видати ключ"); never commit
# NC_AGENT_INTERVAL_SECONDS=30
# PM2 inventory (ADR-016) — enables a separate report loop; the file is written by the exporter, read-only for the Agent.
# NC_AGENT_INVENTORY_FILE=/var/lib/node-control-pm2/inventory.json
# NC_AGENT_INVENTORY_INTERVAL_SECONDS=60
# NC_AGENT_INVENTORY_MAX_AGE_SECONDS=120
# PM2 control (ADR-017) — enables polling for commands; the broker socket (group nc-pm2-control) is the only path to PM2.
# NC_AGENT_CONTROL_SOCKET=/run/node-control-pm2-broker/broker.sock

# --- PM2 exporter (ADR-016) — /etc/node-control-pm2-exporter/<pm2-owner>.env (644, NO secrets).
# NC_PM2_HOME=/home/<pm2-owner>/.pm2
# NC_PM2_SNAPSHOT_FILE=/var/lib/node-control-pm2/inventory.json
# NC_PM2_SOURCE=pm2

# --- PM2 control broker (ADR-017) — /etc/node-control-pm2-broker/<pm2-owner>.env (644, NO secrets).
# NC_PM2_HOME=/home/<pm2-owner>/.pm2
# NC_BROKER_ALLOWLIST=/etc/node-control-pm2-broker/<pm2-owner>.allowlist.json   (root:root 644, empty by default)
# Log tail (ADR-018): directories log files may be read from; default <NC_PM2_HOME>/logs. Per target: "logs": true in the allowlist.
# NC_BROKER_LOG_DIRS=/home/<pm2-owner>/.pm2/logs
