{
  "name": "goit-node-control",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized monitoring and management platform for Node.js projects across multiple servers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "check:secrets": "node scripts/check-secrets.js",
    "check": "npm run check:secrets && npm test && npm run test:integration",
    "db:setup": "node scripts/setup-postgres.js",
    "db:check": "node scripts/db-check.js",
    "backend:dev": "tsx watch backend/src/main.ts",
    "backend:build": "rm -rf backend/dist && tsc -p backend/tsconfig.build.json",
    "backend:start": "node backend/dist/main.js",
    "test:backend": "vitest run --config backend/vitest.config.ts",
    "test:backend:smoke": "npm run backend:build && BACKEND_TEST_SUITE=smoke vitest run --config backend/vitest.config.ts",
    "test:backend:db": "BACKEND_TEST_SUITE=db vitest run --config backend/vitest.config.ts",
    "lint": "eslint backend frontend e2e agent",
    "typecheck": "tsc -p backend/tsconfig.json && tsc -p frontend/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p agent/tsconfig.json",
    "check:local": "npm run check:secrets && npm test && npm run typecheck && npm run lint && npm run test:backend && npm run test:backend:smoke && npm run test:agent && npm run agent:build && npm run test:frontend && npm run frontend:build",
    "db:migrate:status": "node backend/dist/migrate.js status",
    "db:migrate:up": "node backend/dist/migrate.js up",
    "test-db:setup": "node scripts/setup-test-db.js",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:preview": "vite preview --config frontend/vite.config.ts",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "npm run backend:build && npm run agent:build && npm run frontend:build && playwright test -c e2e/playwright.config.ts",
    "agent:build": "rm -rf agent/dist && tsc -p agent/tsconfig.build.json",
    "test:agent": "vitest run --config agent/vitest.config.ts",
    "test:agent:pm2": "NC_TEST_REAL_PM2=1 vitest run --config agent/vitest.config.ts test/pm2-real.test.ts"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "node-pg-migrate": "9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
