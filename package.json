{
  "name": "goit-node-control",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized monitoring and management platform for Node.js projects across multiple servers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "check:secrets": "node scripts/check-secrets.js",
    "check": "npm run check:secrets && npm test && npm run test:integration",
    "db:setup": "node scripts/setup-postgres.js",
    "db:check": "node scripts/db-check.js",
    "backend:dev": "tsx watch backend/src/main.ts",
    "backend:build": "rm -rf backend/dist && tsc -p backend/tsconfig.build.json",
    "backend:start": "node backend/dist/main.js",
    "test:backend": "vitest run --config backend/vitest.config.ts",
    "test:backend:smoke": "npm run backend:build && BACKEND_TEST_SUITE=smoke vitest run --config backend/vitest.config.ts",
    "test:backend:db": "BACKEND_TEST_SUITE=db vitest run --config backend/vitest.config.ts",
    "lint": "eslint backend",
    "typecheck": "tsc -p backend/tsconfig.json",
    "check:local": "npm run check:secrets && npm test && npm run typecheck && npm run lint && npm run test:backend && npm run test:backend:smoke"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}
