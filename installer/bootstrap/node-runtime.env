# Node.js runtime of Node Control — the single source for install.sh, the guided preparation and build-release.js.
# NODE_MIN: the lowest Node.js 22 the locked dependencies accept (package-lock.json engines; react-router: >=22.22.0).
# NODE_VERSION: the official build install.sh downloads when the server has no compatible Node.js 22, pinned by the
# SHA-256 values below (copied from https://nodejs.org/dist/v<NODE_VERSION>/SHASUMS256.txt). Changing the version means
# changing all three values in one reviewed commit.
NODE_MIN=22.22.0
NODE_VERSION=22.23.4
SHA256_LINUX_X64=b8492284c76a54baf58d61668dd0e41ee0fc98adabf9503d30f05d08f55b4406
SHA256_LINUX_ARM64=f7a1e486dbc8b286847815b477d4fb5e9fb963ed4489c3e1588853d685f589f9
