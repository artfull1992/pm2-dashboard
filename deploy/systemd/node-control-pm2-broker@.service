# Node Control — local PM2 control broker (ADR-017). Instance name = the Linux user that owns PM2 (never
# root: the broker refuses UID 0 itself, exit 2), e.g. node-control-pm2-broker@deploy.service.
# Executes ONLY typed start/stop/restart for targets in the ROOT-OWNED allowlist; no shell, no network.
# Config (no secrets): /etc/node-control-pm2-broker/%i.env — NC_PM2_HOME, NC_BROKER_ALLOWLIST.
# Socket: /run/node-control-pm2-broker/broker.sock (0660 %i:nc-pm2-control → the Agent only).
# Journal (dedup): /var/lib/node-control-pm2-broker (0700). Stopping the broker never stops PM2 processes.
# There is deliberately no ConditionUser= (it would test the manager's user, not User=; see ADR-016/Task 008.1).

[Unit]
Description=Node Control PM2 control broker (%i)
Documentation=https://github.com/artfull1992/pm2-dashboard/blob/main/docs/DEPLOYMENT.md
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=exec
User=%i
# Primary group: the socket and runtime directory get it; only nodecontrol-agent is a member.
Group=nc-pm2-control
EnvironmentFile=/etc/node-control-pm2-broker/%i.env
ExecStart=/usr/bin/node /opt/node-control-agent/current/agent/dist/pm2-broker.js serve
RuntimeDirectory=node-control-pm2-broker
RuntimeDirectoryMode=0750
StateDirectory=node-control-pm2-broker
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2
KillSignal=SIGTERM
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal
SyslogIdentifier=node-control-pm2-broker
UMask=0007

# Hardening. Needs: connect() to PM2_HOME/rpc.sock (read-only mount is enough), its own runtime/state dirs,
# no network (AF_UNIX only). Bounded resources; the PM2 daemon and apps are outside this unit's cgroup.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=128M
TasksMax=32
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
